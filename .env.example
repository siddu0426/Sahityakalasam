# Base Path (optional, e.g. /narrate if hosted under a sub-path)
NEXT_PUBLIC_BASE_PATH=

# App URL for webhooks and share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (₹20 entry fee for story upload)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email / Notifications (Resend or SMTP)
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_FROM_EMAIL=notifications@kathalu.app

# Admin Credentials / Secret for cron verification
CRON_SECRET=kathalu_cron_secret_weekly_tally
ADMIN_EMAILS=admin@kathalu.app,msvss@kathalu.app
ADMIN_PHONES=+919876543210
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true
